{
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua"
  ],
  "diagnostics.globals": ["vim"],
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "$VIMRUNTIME",
    "${3rd}/luv/library",
    "~/.local/share/nvim/lazy"
  ],
  "workspace.ignoreDir": [
    "~/.local/share/nvim/lazy/copilot.lua/copilot"
  ]
}
